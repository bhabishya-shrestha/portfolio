# NOTE: Anything prefixed with VITE_ is bundled into the public JS.
# Never put secrets (AI/API keys) here; keep them server-side (Vercel function env vars).

# Firebase Configuration (web config is public by design; protect data with Firestore rules)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Configuration
VITE_APP_NAME=Portfolio
VITE_APP_ENV=development
